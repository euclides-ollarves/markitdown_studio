# MarkItDown Studio - Environment Configuration Template
# Copy this file to .env and configure your keys

# OpenRouter / OpenAI Configuration (For Image OCR & Multimodal Vision)
OPENROUTER_API_KEY=your_openrouter_or_openai_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Server Configuration
HOST=127.0.0.1
PORT=8000
