# MarkItDown Studio - Environment Configuration Template
# Copy this file to .env and configure your keys

# NVIDIA Build / Nemotron OCR Configuration
NVIDIA_API_KEY=your_nvidia_nvapi_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-nano-12b-v2-vl

# OpenRouter / OpenAI Configuration (Alternative)
OPENROUTER_API_KEY=your_openrouter_or_openai_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Active Default Engine
LLM_API_KEY=your_active_api_key_here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-nano-12b-v2-vl

# Server Configuration
HOST=127.0.0.1
PORT=8000
